# Copy to .env for `docker compose up --build`.
# Local `runserver` and `pytest` deliberately do not read this file: they use SQLite.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Compose is plain HTTP on localhost, so secure cookies must be disabled here.
# In Kubernetes (HTTPS), leave this unset: it defaults to on when DEBUG=0.
DJANGO_SECURE_COOKIES=0

# Set by docker-compose.yml by default. Point at your host Postgres in Kubernetes.
DATABASE_URL=postgres://liftlist:liftlist@db:5432/liftlist

# Optional: created on container start when both are set.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

GUNICORN_WORKERS=2
